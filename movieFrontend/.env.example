# Copy to .env and fill in.
#
# Vite inlines these at BUILD time, not run time — changing either one means
# rebuilding. On a host, set them as build environment variables. If either is
# missing the build fails deliberately (see src/config.ts).

VITE_API_URL=http://127.0.0.1:8000
VITE_TMDB_IMAGE_URL=https://image.tmdb.org/t/p
