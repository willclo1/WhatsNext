# Copy to .env and fill in. Never commit the real .env.

# https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_api_key

# Must use the +psycopg driver — a bare postgresql:// URL makes SQLAlchemy
# reach for psycopg2, which this project does not install.
#   local:  postgresql+psycopg://localhost:5432/movies
#   hosted: postgresql+psycopg://user:password@host/dbname?sslmode=require
DATABASE_URL=postgresql+psycopg://localhost:5432/movies

# Comma-separated browser origins allowed to call the API.
# Unset falls back to http://localhost:5173,http://127.0.0.1:5173
# ALLOWED_ORIGINS=https://sixdegrees.pages.dev
